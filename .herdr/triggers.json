{
  "schema_version": 1,
  "package_roots": [
    "skills/*"
  ],
  "package_change_lines": 400,
  "trust_boundary_paths": [
    ".github/workflows/*",
    "skills/check-cfps/*",
    "skills/nightly-cfp-sync/*"
  ],
  "cli_spec_paths": [
    "skills/*/scripts/*.py"
  ],
  "cli_surface_markers": [
    "add_parser(",
    "add_argument(",
    "ArgumentParser("
  ],
  "user_doc_paths": [
    "README.md",
    "skills/*/SKILL.md"
  ]
}
